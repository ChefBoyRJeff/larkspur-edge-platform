# Alertmanager configuration (see docs/adr/0007). Not applied directly: seal-config.ps1 fills
# in the @@...@@ values and seals the result into
# platform/config/monitoring/alertmanager-config.sealedsecret.yaml, which Argo CD applies.
global:
  resolve_timeout: 5m
  # Gmail's SMTP server with an app password (Google account with 2-step verification).
  smtp_smarthost: smtp.gmail.com:587
  smtp_from: "Larkspur alerts <@@GMAIL_ADDRESS@@>"
  smtp_auth_username: "@@GMAIL_ADDRESS@@"
  smtp_auth_password: "@@GMAIL_APP_PASSWORD@@"
  smtp_require_tls: true

route:
  receiver: email
  group_by: ["namespace", "alertname"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 12h
  routes:
    # Watchdog always fires. Each minute it pings healthchecks.io (a dead man's switch); when the
    # pings stop (Prometheus, Alertmanager or the whole site down), healthchecks.io emails instead.
    - receiver: deadmans-switch
      matchers: ['alertname = "Watchdog"']
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 1m
    - receiver: "null"
      matchers: ['alertname = "InfoInhibitor"']
    # Informational alerts stay on the Alertmanager page.
    - receiver: "null"
      matchers: ['severity = "info"']

receivers:
  - name: "null"
  - name: deadmans-switch
    webhook_configs:
      - url: "@@HEALTHCHECKS_PING_URL@@"
        send_resolved: false
  - name: email
    email_configs:
      - to: "@@GMAIL_ADDRESS@@"
        send_resolved: true

# From the chart's defaults: a critical alert silences the matching warning, and so on.
inhibit_rules:
  - source_matchers: ['severity = critical']
    target_matchers: ['severity =~ warning|info']
    equal: ["namespace", "alertname"]
  - source_matchers: ['severity = warning']
    target_matchers: ['severity = info']
    equal: ["namespace", "alertname"]
  - source_matchers: ['alertname = InfoInhibitor']
    target_matchers: ['severity = info']
    equal: ["namespace"]
  - target_matchers: ['alertname = InfoInhibitor']
